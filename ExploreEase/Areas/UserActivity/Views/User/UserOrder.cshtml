@model IEnumerable<Models.Models.PaymentModel>

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var now = DateTime.Now.Date;

    // Columns needed per section
    bool showExtendColumn = Model.Any(order => now >= order.StartDate.ToDateTime(TimeOnly.MinValue) && now <= order.EndDate.ToDateTime(TimeOnly.MinValue) && order.extendedDate != true);
    bool showReviewColumn = Model.Any(order => now > order.EndDate.ToDateTime(TimeOnly.MinValue) && order.Reviewed != true);

    // Helper filters:
    var upcomingOrders = Model.Where(order => order.StartDate.ToDateTime(TimeOnly.MinValue) > now).ToList();
    var ongoingOrders = Model.Where(order => now >= order.StartDate.ToDateTime(TimeOnly.MinValue) && now <= order.EndDate.ToDateTime(TimeOnly.MinValue)).ToList();
    var doneOrders = Model.Where(order => order.EndDate.ToDateTime(TimeOnly.MinValue) < now).ToList();
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    /* Tabs container */
    .tabs {
        display: flex;
        border-bottom: 2px solid #2c7bbf; /* darker sky blue */
        margin-bottom: 1rem;
        font-family: Arial, sans-serif;
        user-select: none;
    }

    .tab-button {
        flex: 1;
        padding: 12px 0;
        cursor: pointer;
        background-color: #e1e7f0;
        border: none;
        border-bottom: 3px solid transparent;
        color: #2c7bbf;
        font-weight: 600;
        font-size: 1rem;
        text-align: center;
        transition: background-color 0.3s, border-bottom-color 0.3s;
    }

        .tab-button:hover {
            background-color: #c9d7f2;
        }

        .tab-button.active {
            background-color: #2c7bbf;
            color: white;
            border-bottom-color: #1a4f8a;
        }

    /* Table styling */
    .order-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .order-table th, .order-table td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
            vertical-align: middle;
        }

        .order-table th {
            background-color: #2c7bbf; /* darker sky blue header */
            color: white;
        }

    /* Buttons */
    .btn {
        padding: 6px 12px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: background-color 0.3s ease;
        color: white;
    }

    .btn-extend {
        background-color: #28a745;
    }

        .btn-extend:hover {
            background-color: #218838;
        }

    .btn-review {
        background-color: #007bff;
    }

        .btn-review:hover {
            background-color: #0056b3;
        }

    .btn-detail {
        background-color: #6c757d;
    }

        .btn-detail:hover {
            background-color: #5a6268;
        }

    /* Hide non-active tabs */
    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }
</style>

<h2>My Orders</h2>

@if (!Model.Any())
{
    <div>You have no orders yet.</div>
}
else
{
    <div class="tabs" role="tablist" aria-label="Tour Orders Tabs">
        <button class="tab-button active" role="tab" aria-selected="true" aria-controls="upcoming" id="tab-upcoming" tabindex="0" onclick="showTab('upcoming')">Upcoming Tours (@upcomingOrders.Count)</button>
        <button class="tab-button" role="tab" aria-selected="false" aria-controls="ongoing" id="tab-ongoing" tabindex="-1" onclick="showTab('ongoing')">Ongoing Tours (@ongoingOrders.Count)</button>
        <button class="tab-button" role="tab" aria-selected="false" aria-controls="done" id="tab-done" tabindex="-1" onclick="showTab('done')">Done Tours (@doneOrders.Count)</button>
    </div>

    <!-- Upcoming Tours -->
    <section id="upcoming" class="tab-content active" role="tabpanel" aria-labelledby="tab-upcoming" tabindex="0">
        @if (!upcomingOrders.Any())
        {
            <p>No upcoming tours found.</p>
        }
        else
        {
            <table class="order-table" aria-label="Upcoming Tours Table">
                <thead>
                    <tr>
                        <th scope="col">Package ID</th>
                        <th scope="col">Start Date</th>
                        <th scope="col">End Date</th>
                        <th scope="col">People</th>
                        <th scope="col">Total Price (Rs.)</th>
                        <th scope="col">Booking Date</th>
                        <th scope="col">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in upcomingOrders)
                    {
                        <tr>
                            <td>@order.Tourpackageid</td>
                            <td>@order.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.NumberOfPeople</td>
                            <td>@order.TotalPrice.ToString("F2")</td>
                            <td>@order.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a class="btn btn-detail"
                                   href="https://localhost:7285/UserActivity/User/OrderDetails?id=@order.id"
                                   role="button">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <!-- Ongoing Tours -->
    <section id="ongoing" class="tab-content" role="tabpanel" aria-labelledby="tab-ongoing" tabindex="0">
        @if (!ongoingOrders.Any())
        {
            <p>No ongoing tours currently.</p>
        }
        else
        {
            <table class="order-table" aria-label="Ongoing Tours Table">
                <thead>
                    <tr>
                        <th scope="col">Package ID</th>
                        <th scope="col">Start Date</th>
                        <th scope="col">End Date</th>
                        <th scope="col">People</th>
                        <th scope="col">Total Price (Rs.)</th>
                        <th scope="col">Booking Date</th>
                        @if (showExtendColumn)
                        {
                            <th scope="col">Extend Date</th>
                        }
                        <th scope="col">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in ongoingOrders)
                    {
                        <tr id="order-row-@order.id">
                            <td>@order.Tourpackageid</td>
                            <td>@order.StartDate.ToString("yyyy-MM-dd")</td>
                            <td class="end-date">@order.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.NumberOfPeople</td>
                            <td>@order.TotalPrice.ToString("F2")</td>
                            <td>@order.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                            @if (showExtendColumn)
                            {
                                <td>
                                    @if (order.extendedDate != true)
                                    {
                                        <button class="btn btn-extend"
                                                data-tourpackageid="@order.Tourpackageid"
                                                data-paymentid="@order.id"
                                                onclick="openExtendModal(this)">
                                            Extend
                                        </button>
                                    }
                                </td>
                            }
                            <td>
                                <a class="btn btn-detail"
                                   href="https://localhost:7285/UserActivity/User/OrderDetails?Tourpackageid=@order.Tourpackageid"
                                   role="button">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <!-- Done Tours -->
    <section id="done" class="tab-content" role="tabpanel" aria-labelledby="tab-done" tabindex="0">
        @if (!doneOrders.Any())
        {
            <p>No completed tours found.</p>
        }
        else
        {
            <table class="order-table" aria-label="Done Tours Table">
                <thead>
                    <tr>
                        <th scope="col">Package ID</th>
                        <th scope="col">Start Date</th>
                        <th scope="col">End Date</th>
                        <th scope="col">People</th>
                        <th scope="col">Total Price (Rs.)</th>
                        <th scope="col">Booking Date</th>
                        @if (showReviewColumn)
                        {
                            <th scope="col">Leave Review</th>
                        }
                        <th scope="col">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in doneOrders)
                    {
                        <tr id="order-row-@order.id">
                            <td>@order.Tourpackageid</td>
                            <td>@order.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.NumberOfPeople</td>
                            <td>@order.TotalPrice.ToString("F2")</td>
                            <td>@order.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                            @if (showReviewColumn)
                            {
                                <td>
                                    @if (order.Reviewed != true)
                                    {
                                        <button class="btn btn-review"
                                                data-packageid="@order.Tourpackageid"
                                                data-paymentid="@order.id"
                                                onclick="openReviewModal(this)">
                                            Leave Review
                                        </button>
                                    }
                                </td>
                            }
                            <td>
                                <a class="btn btn-detail"
                                   href="https://localhost:7285/UserActivity/User/OrderDetails?Tourpackageid=@order.Tourpackageid"
                                   role="button">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

<!-- (Include your existing modals for Extend Date and Review here, unchanged) -->

<script>
    // Tab switching function
    function showTab(tabId) {
        // Hide all tab contents
        document.querySelectorAll('.tab-content').forEach(content => {
            content.classList.remove('active');
        });

        // Remove active class from all buttons
        document.querySelectorAll('.tab-button').forEach(btn => {
            btn.classList.remove('active');
            btn.setAttribute('aria-selected', 'false');
            btn.tabIndex = -1;
        });

        // Show selected tab content
        const selectedContent = document.getElementById(tabId);
        if (selectedContent) {
            selectedContent.classList.add('active');
            selectedContent.focus();
        }

        // Mark selected tab button active and keyboard focusable
        const selectedBtn = document.getElementById(`tab-${tabId}`);
        if (selectedBtn) {
            selectedBtn.classList.add('active');
            selectedBtn.setAttribute('aria-selected', 'true');
            selectedBtn.tabIndex = 0;
            selectedBtn.focus();
        }
    }

    // Optionally, allow arrow keys to navigate tabs for accessibility
    document.querySelectorAll('.tab-button').forEach((btn, index, arr) => {
        btn.addEventListener('keydown', e => {
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                e.preventDefault();
                let nextIndex = (index + 1) % arr.length;
                arr[nextIndex].focus();
            }
            if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                e.preventDefault();
                let prevIndex = (index - 1 + arr.length) % arr.length;
                arr[prevIndex].focus();
            }
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                btn.click();
            }
        });
    });

    // Existing modal JS code for Extend and Review modals goes here (not repeated for brevity)
</script>
