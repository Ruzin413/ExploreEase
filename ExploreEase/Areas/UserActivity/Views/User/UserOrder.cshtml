@model IEnumerable<Models.Models.PaymentModel>

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var now = DateTime.Now.Date;
    // Columns needed per section
    bool showExtendColumn = Model.Any(order => now >= order.StartDate.ToDateTime(TimeOnly.MinValue) && now <= order.EndDate.ToDateTime(TimeOnly.MinValue) && order.extendedDate != true);
    bool showReviewColumn = Model.Any(order => now > order.EndDate.ToDateTime(TimeOnly.MinValue) && order.Reviewed != true);
    // Helper filters:
    var upcomingOrders = Model.Where(order => order.StartDate.ToDateTime(TimeOnly.MinValue) > now).ToList();
    var ongoingOrders = Model.Where(order => now >= order.StartDate.ToDateTime(TimeOnly.MinValue) && now <= order.EndDate.ToDateTime(TimeOnly.MinValue)).ToList();
    var doneOrders = Model.Where(order => order.EndDate.ToDateTime(TimeOnly.MinValue) < now).ToList();
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    /* Tabs container */
    .star-rating {
        direction: rtl;
        font-size: 1.8rem;
        unicode-bidi: bidi-override;
        display: inline-flex;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            color: #ccc;
            cursor: pointer;
            transition: color 0.2s;
            padding: 0 2px;
        }

            .star-rating label:hover,
            .star-rating label:hover ~ label,
            .star-rating input:checked ~ label {
                color: #f5b301;
            }

    .tabs {
        display: flex;
        border-bottom: 2px solid #2c7bbf;
        margin-bottom: 1rem;
        font-family: Arial, sans-serif;
        user-select: none;
    }

    .tab-button {
        flex: 1;
        padding: 12px 0;
        cursor: pointer;
        background-color: #e1e7f0;
        border: none;
        border-bottom: 3px solid transparent;
        color: #2c7bbf;
        font-weight: 600;
        font-size: 1rem;
        text-align: center;
        transition: background-color 0.3s, border-bottom-color 0.3s;
    }

        .tab-button:hover {
            background-color: #c9d7f2;
        }

        .tab-button.active {
            background-color: #2c7bbf;
            color: white;
            border-bottom-color: #1a4f8a;
        }

    .order-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .order-table th, .order-table td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
            vertical-align: middle;
        }

        .order-table th {
            background-color: #2c7bbf;
            color: white;
        }

    .btn {
        padding: 6px 12px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: background-color 0.3s ease;
        color: white;
    }

    .btn-extend {
        background-color: #28a745;
    }

        .btn-extend:hover {
            background-color: #218838;
        }

    .btn-review {
        background-color: #007bff;
    }

        .btn-review:hover {
            background-color: #0056b3;
        }

    .btn-detail {
        background-color: #6c757d;
    }

        .btn-detail:hover {
            background-color: #5a6268;
        }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

    .modal-message {
        margin-top: 10px;
        font-weight: 500;
    }
</style>

<h2>My Orders</h2>

@if (!Model.Any())
{
    <div>You have no orders yet.</div>
}
else
{
    <div class="tabs" role="tablist" aria-label="Tour Orders Tabs">
        <button class="tab-button active" role="tab" aria-selected="true" aria-controls="upcoming" id="tab-upcoming" tabindex="0" onclick="showTab('upcoming')">Upcoming Tours (@upcomingOrders.Count)</button>
        <button class="tab-button" role="tab" aria-selected="false" aria-controls="ongoing" id="tab-ongoing" tabindex="-1" onclick="showTab('ongoing')">Ongoing Tours (@ongoingOrders.Count)</button>
        <button class="tab-button" role="tab" aria-selected="false" aria-controls="done" id="tab-done" tabindex="-1" onclick="showTab('done')">Done Tours (@doneOrders.Count)</button>
    </div>

    <!-- Upcoming Tours -->
    <section id="upcoming" class="tab-content active" role="tabpanel" aria-labelledby="tab-upcoming" tabindex="0">
        @if (!upcomingOrders.Any())
        {
            <p>No upcoming tours found.</p>
        }
        else
        {
            <table class="order-table">
                <thead>
                    <tr>
                        <th>Package ID</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>People</th>
                        <th>Total Price (Rs.)</th>
                        <th>Booking Date</th>
                        <th>Arriving Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in upcomingOrders)
                    {
                        <tr>
                            <td>@order.Tourpackageid</td>
                            <td>@order.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.NumberOfPeople</td>
                            <td>@order.TotalPrice.ToString("F2")</td>
                            <td>@order.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a class="btn btn-detail" href="https://localhost:7285/UserActivity/User/OrderDetails?id=@order.id">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    <section id="ongoing" class="tab-content" role="tabpanel" aria-labelledby="tab-ongoing" tabindex="0">
        @if (!ongoingOrders.Any())
        {
            <p>No ongoing tours currently.</p>
        }
        else
        {
            <table class="order-table">
                <thead>
                    <tr>
                        <th>Package ID</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>People</th>
                        <th>Total Price (Rs.)</th>
                        <th>Booking Date</th>
                        @if (showExtendColumn)
                        {
                            <th>Extend Date</th>
                        }
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in ongoingOrders)
                    {
                        <tr id="order-row-@order.id">
                            <td>@order.Tourpackageid</td>
                            <td>@order.StartDate.ToString("yyyy-MM-dd")</td>
                            <td class="end-date">@order.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.NumberOfPeople</td>
                            <td>@order.TotalPrice.ToString("F2")</td>
                            <td>@order.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                            @if (showExtendColumn)
                            {
                                <td>
                                    @if (order.extendedDate != true)
                                    {
                                        <button class="btn btn-extend"
                                                data-tourpackageid="@order.Tourpackageid"
                                                data-paymentid="@order.id"
                                                onclick="openExtendModal(this)">
                                            Extend
                                        </button>
                                    }
                                </td>
                            }
                            <td>
                                <a class="btn btn-detail" href="https://localhost:7285/UserActivity/User/OrderDetails?id=@order.id">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    <section id="done" class="tab-content" role="tabpanel" aria-labelledby="tab-done" tabindex="0">
        @if (!doneOrders.Any())
        {
            <p>No completed tours found.</p>
        }
        else
        {
            <table class="order-table">
                <thead>
                    <tr>
                        <th>Package ID</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>People</th>
                        <th>Total Price (Rs.)</th>
                        <th>Booking Date</th>
                        @if (showReviewColumn)
                        {
                            <th>Leave Review</th>
                        }
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in doneOrders)
                    {
                        <tr id="order-row-@order.id">
                            <td>@order.Tourpackageid</td>
                            <td>@order.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.NumberOfPeople</td>
                            <td>@order.TotalPrice.ToString("F2")</td>
                            <td>@order.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                            @if (showReviewColumn)
                            {
                                <td>
                                    @if (order.Reviewed != true)
                                    {
                                        <button class="btn btn-review"
                                                data-packageid="@order.Tourpackageid"
                                                data-paymentid="@order.id"
                                                onclick="openReviewModal(this)">
                                            Leave Review
                                        </button>
                                    }
                                </td>
                            }
                            <td>
                                <a class="btn btn-detail" href="https://localhost:7285/UserActivity/User/OrderDetails?id=@order.id">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}
<div id="extendModal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999;">
    <div style="background:white; margin:10% auto; padding:20px; width:300px; border-radius:8px; text-align:center;">
        <h3>Extend Tour Date</h3>
        <p>Are you sure you want to extend this tour?</p>
        <input type="hidden" id="extend-paymentid">
        <input type="hidden" id="extend-tourpackageid">
        <button class="btn btn-extend" id="confirmExtend">Yes, Extend</button>
        <button class="btn btn-detail" onclick="closeExtendModal()">Cancel</button>
    </div>
</div>

<div id="reviewModal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999;">
    <div style="background:white; margin:5% auto; padding:20px; width:400px; border-radius:8px; position:relative;">
        <span style="cursor:pointer; position:absolute; top:10px; right:15px; font-size:24px;" onclick="closeReviewModal()">&times;</span>
        <h3>Leave Review</h3>

        <input type="hidden" id="review-paymentid">
        <input type="hidden" id="review-packageid">

        <label>Rating:</label>
        <div class="star-rating">
            <input type="radio" name="rating" id="star5" value="5"><label for="star5">&#9733;</label>
            <input type="radio" name="rating" id="star4" value="4"><label for="star4">&#9733;</label>
            <input type="radio" name="rating" id="star3" value="3"><label for="star3">&#9733;</label>
            <input type="radio" name="rating" id="star2" value="2"><label for="star2">&#9733;</label>
            <input type="radio" name="rating" id="star1" value="1"><label for="star1">&#9733;</label>
        </div>

        <textarea id="review-text" rows="4" style="width:100%; margin-top:10px;"></textarea>

        <button class="btn btn-review" id="submitReviewBtn" style="margin-top:10px;">Submit Review</button>

        <div id="reviewMessage" class="modal-message" style="display:none;"></div>
    </div>
</div>
<script src="~/js/userorder.js"></script>