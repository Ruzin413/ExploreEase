@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
<style>
    .login-container {
        max-width: 400px;
        margin: 2rem auto;
        padding: 2rem;
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-form h2 {
        font-weight: 600;
        margin-bottom: 1rem;
        text-align: center;
        color: #333;
    }

    .form-floating > input.form-control {
        height: 3.5rem;
        font-size: 1rem;
    }

    .btn-primary {
        background-color: #0069d9;
        border: none;
        font-size: 1.1rem;
        padding: 0.75rem;
        transition: background-color 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #0053ba;
        }

    .login-links {
        font-size: 0.9rem;
        text-align: center;
        margin-top: 1rem;
    }

        .login-links a {
            color: #0069d9;
            text-decoration: none;
        }

            .login-links a:hover {
                text-decoration: underline;
            }

    .alert-info {
        background-color: #d1ecf1;
        color: #0c5460;
        padding: 0.75rem 1rem;
        border-radius: 4px;
        margin-bottom: 1rem;
        text-align: center;
    }

</style>
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}
<div class="login-container">
    <form id="account" method="post" class="login-form">
        <h2>Use your account to log in</h2>
        <hr />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
            <label asp-for="Input.Email">Email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" placeholder="Password" />
            <label asp-for="Input.Password">Password</label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="checkbox mb-3">
            <label asp-for="Input.RememberMe" class="form-label">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                @Html.DisplayNameFor(m => m.Input.RememberMe)
            </label>
        </div>

        <button id="login-submit" type="submit" class="btn btn-primary w-100">Log in</button>

        <div class="login-links mt-3">
            <a asp-page="./ForgotPassword">Forgot your password?</a><br />
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a><br />
            <a asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
