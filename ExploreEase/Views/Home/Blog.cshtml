<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ExploreEase | Blog</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/blog.css">
</head>
<body>
    <!-- Header -->
    <header class="blog-header">
        <div class="header-content">
            <a href="/" class="logo">Your feed</a>
            <button class="add-post-btn" onclick="document.getElementById('modal').showModal()">
                <i class="fas fa-plus"></i> New Post
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main>
        <div id="blogsContainer"><!-- Blog posts will be loaded here --></div>
    </main>

    <!-- Add Post Modal -->
    <dialog id="modal">
        <div style="padding: 20px;">
            <h2>Create New Post</h2>
            <form id="blogForm">
                <div style="margin-bottom: 16px;">
                    <textarea name="text" placeholder="Write a caption..." required style="width: 100%; height: 100px;"></textarea>
                </div>
                <div style="margin-bottom: 16px;">
                    <label for="image" style="display: block; margin-bottom: 8px; font-weight: 600;">Upload Photo</label>
                    <input type="file" name="image" id="image" accept="image/*" required style="width: 100%;">
                </div>
                <div style="display: flex; gap: 8px;">
                    <button type="submit" name="submit" class="primary-btn">Share</button>
                    <button type="button" onclick="document.getElementById('modal').close()" class="secondary-btn">Cancel</button>
                </div>
            </form>
        </div>
    </dialog>

    <!-- Comments Modal -->
    <dialog id="commentModal">
        <div style="padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 16px;">Comments</h3>
                <button onclick="document.getElementById('commentModal').close()" style="background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
            </div>
            <div id="commentsList" style="margin-bottom: 16px; max-height: 400px; overflow-y: auto;">
                <!-- Comments will be loaded here -->
            </div>
            <form id="commentForm" style="border-top: 1px solid var(--border-color); padding-top: 12px;">
                <input type="hidden" name="BlogId" id="commentBlogId" />
                <div style="display: flex; gap: 8px;">
                    <textarea name="CommentText" placeholder="Add a comment..." required style="flex: 1; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; resize: none; height: 38px;"></textarea>
                    <button type="submit" class="primary-btn" style="align-self: flex-end;">Post</button>
                </div>
            </form>
        </div>
    </dialog>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/blog.js"></script>
</body>
</html>