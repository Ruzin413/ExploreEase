@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Discover amazing destinations with ExploreEase - Your gateway to unforgettable travel experiences" />
    <title>@ViewData["Title"] - ExploreEase</title>
    <link href="~/css/HomeIndex.css" rel="stylesheet" />
    <link href="~/tailwindcss/tailwind.min.css" rel="stylesheet" />
    <link href="~/tailwindcss/tailwind.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
    <!-- Banner Section -->
    <section class="banner-section" aria-label="Search destinations">
        <div class="banner-image-container">
            <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80"
                 alt="Beautiful mountain landscape with lake reflection"
                 class="banner-image" />
            <div class="banner-gradient-overlay"></div>
            <div class="banner-content">
                <div class="banner-text">
                    <h1 class="banner-title">Find Your Perfect Adventure</h1>
                    <p class="banner-subtitle">Discover breathtaking destinations and create unforgettable memories</p>
                </div>
                <!-- Updated search form: method GET, input with name="name" -->
                <form class="searchbar-form"
                      id="searchForm"
                      method="get"
                      action="/Home/Search"
                      autocomplete="off"
                      role="search">
                    <div class="search-input-wrapper">
                        <i class="fas fa-map-marker-alt search-icon"></i>
                        <input type="text"
                               name="name"
                               class="searchbar-input"
                               id="searchInput"
                               placeholder="Where would you like to explore?"
                               aria-label="Search destinations" />
                        <div class="search-suggestions" id="searchSuggestions"></div>
                    </div>
                    <button type="submit" class="searchbar-btn" aria-label="Search">
                        <i class="fas fa-search"></i>
                        <span class="btn-text">Search</span>
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Recommendations Section -->
    <section class="recommendations-section" id="recommendationSection" aria-label="Recommended tours">
        <div class="container">
            <div class="section-header">
                <div class="section-badge">
                    <i class="fas fa-sparkles"></i>
                    <span>Personalized</span>
                </div>
                <div class="section-title">
                    <i class="fas fa-star section-icon"></i>
                    <h2>Recommended for You</h2>
                </div>
                <p class="section-subtitle">
                    Handpicked destinations based on your travel preferences and interests
                </p>
            </div>
            <div class="tour-container">
                <button class="scroll-btn scroll-left"
                        id="recScrollLeft"
                        disabled
                        aria-label="Scroll left">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="horizontal-scroll"
                     id="recPackageContainer"
                     role="region"
                     aria-label="Recommended tour packages"></div>
                <button class="scroll-btn scroll-right" id="recScrollRight" aria-label="Scroll right">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Tour Packages Section -->
    <section class="packages-section" aria-label="All tour packages">
        <div class="container">
            <div class="section-header">
                <div class="section-badge">
                    <i class="fas fa-globe-americas"></i>
                    <span>Explore All</span>
                </div>
                <div class="section-title">
                    <i class="fas fa-compass section-icon"></i>
                    <h2>All Tour Packages</h2>
                </div>
                <p class="section-subtitle">
                    Discover amazing destinations around the world with our comprehensive collection
                </p>
                <div class="section-filters">
                    <button class="filter-btn active" data-filter="all">
                        <i class="fas fa-th"></i>
                        All Packages
                    </button>
                </div>
            </div>
            <div class="tour-container">
                <button class="scroll-btn scroll-left"
                        id="pkgScrollLeft"
                        disabled
                        aria-label="Scroll left">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="horizontal-scroll"
                     id="pkgPackageContainer"
                     role="region"
                     aria-label="All tour packages"></div>
                <button class="scroll-btn scroll-right" id="pkgScrollRight" aria-label="Scroll right">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="loading-overlay">
        <div class="loading-content">
            <div class="spinner"></div>
            <p>Loading amazing destinations...</p>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Hide loading spinner after page load
            setTimeout(() => {
                $('#loadingSpinner').fadeOut();
            }, 1000);

            // -------------------- Recommendations --------------------
            function fetchRecommendedPackages() {
                $.ajax({
                    url: '/Home/GetRecommendationsForCurrentUser',
                    method: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        let html = '';
                        if (Array.isArray(data) && data.length > 0) {
                            data.forEach(function (pkg) {
                                html += `
                                    <div class="tour-card" data-id="${pkg.tourPackageId}" data-rating="${pkg.rating}" data-days="${pkg.numberOfDays}" style="cursor:pointer;">
                                        <img src="${pkg.destinationImage}" class="card-img-top" alt="${pkg.name}">
                                        <div class="card-body">
                                            <h5 class="card-title">${pkg.name}</h5>
                                            <div class="card-meta">
                                                <span class="duration">
                                                    <i class="fas fa-calendar"></i>
                                                    ${pkg.numberOfDays} days
                                                </span>
                                                <span class="rating">
                                                    <i class="fas fa-star"></i>
                                                    ${pkg.rating}
                                                </span>
                                            </div>
                                            <div class="description">${pkg.description.substring(0, 80)}...</div>
                                            <div class="card-details">
                                                <p class="card-text">
                                                    <i class="fas fa-map-marker-alt"></i>
                                                    <strong>Destination:</strong> ${pkg.destination}
                                                </p>
                                            </div>
                                            <div class="card-price">
                                                <span class="price">Rs${pkg.price}</span>
                                                <button class="view-details-btn">
                                                    <i class="fas fa-eye"></i>
                                                    View Details
                                                </button>
                                            </div>
                                        </div>
                                    </div>`;
                            });
                            $('#recommendationSection').show();
                        } else {
                            $('#recommendationSection').hide();
                        }
                        $('#recPackageContainer').html(html);
                        initScrollButtons('rec');
                    },
                    error: function () {
                        $('#recommendationSection').hide();
                        $('#recPackageContainer').html(`
                            <div class="error-message">
                                <i class="fas fa-exclamation-triangle"></i>
                                <p>Could not load recommendations.</p>
                            </div>
                        `);
                    }
                });
            }

            // -------------------- Tour Packages --------------------
            function fetchTourPackages() {
                $.ajax({
                    url: '/Home/TourPackage',
                    method: 'GET',
                    success: function (data) {
                        // Sort data by rating (highest to lowest)
                        data.sort((a, b) => (b.rating || 0) - (a.rating || 0));

                        let html = '';
                        data.forEach(function (pkg) {
                            html += `
                                <div class="tour-card" data-id="${pkg.tourPackageId}" data-rating="${pkg.rating}" data-days="${pkg.numberOfDays}" style="cursor:pointer;">
                                    <img src="${pkg.destinationImage}" class="card-img-top" alt="${pkg.name}">
                                    <div class="card-body">
                                        <h5 class="card-title">${pkg.name}</h5>
                                        <div class="card-meta">
                                            <span class="duration">
                                                <i class="fas fa-calendar"></i>
                                                ${pkg.numberOfDays} days
                                            </span>
                                            <span class="rating">
                                                <i class="fas fa-star"></i>
                                                ${pkg.rating}
                                            </span>
                                        </div>
                                        <div class="description">${pkg.description.substring(0, 80)}...</div>
                                        <div class="card-details">
                                            <p class="card-text">
                                                <i class="fas fa-map-marker-alt"></i>
                                                <strong>Destination:</strong> ${pkg.destination}
                                            </p>
                                        </div>
                                        <div class="card-price">
                                            <span class="price">Rs${pkg.price}</span>
                                            <button class="view-details-btn">
                                                <i class="fas fa-eye"></i>
                                                View Details
                                            </button>
                                        </div>
                                    </div>
                                </div>`;
                        });
                        $('#pkgPackageContainer').html(html);
                        initScrollButtons('pkg');
                    },
                    error: function () {
                        $('#pkgPackageContainer').html(`
                            <div class="error-message">
                                <i class="fas fa-exclamation-triangle"></i>
                                <p>Could not load tour packages.</p>
                            </div>
                        `);
                    }
                });
            }

            // -------------------- Scroll Button Initializer --------------------
            function initScrollButtons(prefix) {
                const container = document.getElementById(`${prefix}PackageContainer`);
                const scrollLeftBtn = document.getElementById(`${prefix}ScrollLeft`);
                const scrollRightBtn = document.getElementById(`${prefix}ScrollRight`);

                if (!container || !scrollLeftBtn || !scrollRightBtn) return;

                const cardWidth = 340;
                const scrollAmount = cardWidth * 2;

                scrollLeftBtn.addEventListener('click', function () {
                    container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                    updateButtonState();
                });

                scrollRightBtn.addEventListener('click', function () {
                    container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                    updateButtonState();
                });

                container.addEventListener('scroll', updateButtonState);

                function updateButtonState() {
                    scrollLeftBtn.disabled = container.scrollLeft <= 0;
                    const maxScrollLeft = container.scrollWidth - container.clientWidth;
                    scrollRightBtn.disabled = Math.abs(container.scrollLeft - maxScrollLeft) < 10;
                }

                updateButtonState();
            }

            // -------------------- Shared Click Event --------------------
            $(document).on('click', '.tour-card', function () {
                const id = $(this).data('id');
                window.location.href = `/UserActivity/User/Booking?id=${id}`;
            });

            // Initial load
            fetchRecommendedPackages();
            fetchTourPackages();
        });
    </script>
</body>
</html>
