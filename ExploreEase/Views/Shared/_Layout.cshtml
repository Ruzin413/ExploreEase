<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExploreEase</title>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/tailwindcss/base.min.css" rel="stylesheet" />
    <link href="~/tailwindcss/base.css" rel="stylesheet" />
    <link href="~/tailwindcss/components.min.css" rel="stylesheet" />
    <link href="~/tailwindcss/components.css" rel="stylesheet" />
    <link href="~/tailwindcss/tailwind.min.css" rel="stylesheet" />
    <link href="~/tailwindcss/tailwind.css" rel="stylesheet" />
    <link href="~/tailwindcss/tailwind-dark.min.css" rel="stylesheet" />
    <link href="~/tailwindcss/tailwind-dark.css" rel="stylesheet" />
    <link href="~/tailwindcss/utilities.min.css" rel="stylesheet" />
    <link href="~/tailwindcss/utilities.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExploreEase.styles.css" asp-append-version="true" />
    
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-hover: #1d4ed8;
            --secondary-color: #64748b;
            --success-color: #059669;
            --danger-color: #dc2626;
            --warning-color: #d97706;
            --dark-color: #1e293b;
            --light-color: #f8fafc;
            --border-color: #e2e8f0;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
        
        body {
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
            color: var(--dark-color);
            background-color: #ffffff;
            margin: 0;
            padding: 0;
        }
        
        html, body {
            height: 100%;
        }
        
        .navbar-simple {
            background-color: #ffffff;
            border-bottom: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            padding: 0.75rem 0;
        }
        
        .navbar-brand-simple {
            font-weight: 600;
            font-size: 1.25rem;
            color: var(--dark-color) !important;
            text-decoration: none;
        }

        .nav-link-simple,
        .navbar-brand-simple {
            text-decoration: none !important;
        }

            .nav-link-simple:hover,
            .navbar-brand-simple:hover {
                text-decoration: underline !important;
            }
        .navbar-brand-simple:hover {
            color: var(--primary-color) !important;
        }
        
        .nav-link-simple {
            color: var(--secondary-color) !important;
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            transition: color 0.3s ease;
            display: flex;
            align-items: center;
        }
        
        .nav-link-simple:hover {
            color: var(--primary-color) !important;
        }
        
        .navbar-nav {
            align-items: center;
        }
        
        .navbar-nav .nav-item {
            display: flex;
            align-items: center;
        }
        
        .navbar-toggler-simple {
            border: 1px solid var(--border-color);
            border-radius: 0.375rem;
        }
        
        .navbar-toggler-simple:focus {
            box-shadow: 0 0 0 0.25rem rgba(37, 140, 251, 0.25);
        }
        
        .main-content {
            flex: 1;
            padding: 2rem 0;
        }
        
        .footer-modern {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            color: #cbd5e1;
            padding: 2rem 0;
            margin-top: auto;
        }
        
        .footer-modern a {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.3s ease;
        }
        
        .footer-modern a:hover {
            color: #e2e8f0;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light navbar-simple">
            <div class="container-fluid">
                <a class="navbar-brand-simple" asp-area="" asp-controller="Home" asp-action="Index">ExploreEase</a>
                <button class="navbar-toggler navbar-toggler-simple" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        @if (User.IsInRole("Admin"))
                        {
                          
                            <li class="nav-item">
                                <a class="nav-link-simple" asp-area="Admin" asp-controller="Admin" asp-action="Index">Admin Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-simple" asp-area="Admin" asp-controller="Admin" asp-action="Users">Manage Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-simple" asp-area="Admin" asp-controller="Admin" asp-action="OrderList">Bookings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-simple" asp-area="Admin" asp-controller="Admin" asp-action="AddServices">Add Services</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-simple" asp-area="Admin" asp-controller="Admin" asp-action="ManageServices">Manage Services</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-simple" asp-area="" asp-controller="Home" asp-action="Blog">Blogs</a>
                            </li>
                        }
                        else if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link-simple" asp-area="UserActivity" asp-controller="User" asp-action="UserOrder">Orders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-simple" asp-area="" asp-controller="Home" asp-action="Blog">Blog</a>
                            </li>
                        }
                    </ul>
                    <div class="ms-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="main-content flex-grow-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer-modern mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-compass me-2"></i>
                        <span class="fw-bold">ExploreEase</span>
                        <span class="ms-2">&copy; 2025</span>
                    </div>
                </div>
                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="me-3">
                        <i class="fas fa-shield-alt me-1"></i>Privacy Policy
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="me-3">
                        <i class="fas fa-file-contract me-1"></i>Terms of Service
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="me-3">
                        <i class="fas fa-envelope me-1"></i>Contact
                    </a>
                    <a href="https://github.com" target="_blank" class="text-decoration-none">
                        <i class="fab fa-github me-1"></i>GitHub
                    </a>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
